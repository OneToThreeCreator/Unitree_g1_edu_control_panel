# Streaming plugin config for Unitree G1 camera (Janus 1.x format)
# Uses media array syntax for proper H.265/H.264 support

general: {
    admin_key = "janusadmin"
    events = false
}

# H.265 stream (primary)
h265-stream: {
    type = "rtp"
    id = 1
    description = "Unitree G1 Camera H.265"
    media = (
        {
            type = "video"
            mid = "v1"
            label = "H.265 video"
            port = 5004
            pt = 96
            codec = "H265"
        }
    )
}

# H.264 stream (fallback)
h264-stream: {
    type = "rtp"
    id = 2
    description = "Unitree G1 Camera H.264"
    media = (
        {
            type = "video"
            mid = "v1"
            label = "H.264 video"
            port = 5006
            pt = 96
            codec = "H264"
            fmtp = "profile-level-id=42e01f;packetization-mode=1"
        }
    )
}
