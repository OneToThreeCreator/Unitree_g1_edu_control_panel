# Minimal Janus config for Unitree G1 camera streaming
general: {
    # Relative paths from janus-conf/ directory
    configs_folder = "."
    plugins_folder = "../janus-local/lib/janus/plugins"
    transports_folder = "../janus-local/lib/janus/transports"
    log_to_stdout = true
    debug_level = 4
    server_name = "Unitree G1 Janus"
}

nat: {
    nice_debug = false
    full_trickle = true
    ice_lite = false
    stun_server = "stun.l.google.com"
    stun_port = 19302
}

media: {
    rtp_port_range = "20000-40000"
}
