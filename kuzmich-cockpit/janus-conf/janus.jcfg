# Minimal Janus config for Unitree G1 camera streaming
# Paths are set via -F (configs) and -P (plugins) flags
general: {
    log_to_stdout = true
    debug_level = 4
    server_name = "Unitree G1 Janus"
}

nat: {
    nice_debug = false
    full_trickle = true
    ice_lite = false
    stun_server = "stun.l.google.com"
    stun_port = 19302
}

media: {
    rtp_port_range = "20000-40000"
}
